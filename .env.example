# LLM API Key（支持所有 OpenAI 兼容服务）
ANTHROPIC_API_KEY=your_api_key_here

# LLM 服务基础地址
# DeepSeek: https://api.deepseek.com
# 千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱: https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.deepseek.com

# 模型名称
# DeepSeek: deepseek-chat（V3）或 deepseek-reasoner（R1）
MODEL=deepseek-chat

# 单次生成最大 token 数
MAX_TOKENS=4096

# Agent 最大循环轮数
MAX_ITERATIONS=10

# 工具执行超时时间（秒）
TOOL_TIMEOUT=30
